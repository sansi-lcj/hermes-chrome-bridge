{
  "name": "hermes-chrome-bridge",
  "version": "1.7.0",
  "description": "Chrome extension that bridges Chrome to a deployed Hermes Agent via its OpenAI-compatible API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package.mjs",
    "build:e2e": "E2E=1 vite build --outDir dist-e2e",
    "e2e": "npm run build:e2e && playwright test",
    "mock": "node scripts/mock-server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/x": "^2.8.0",
    "antd": "^6.4.3",
    "dompurify": "^3.1.6",
    "marked": "^14.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.43",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
